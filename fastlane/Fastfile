default_platform(:ios)

APP_ID  = "Nebo.OurStory"
PROJECT = "OurStory.xcodeproj"
SCHEME  = "OurStory"
TARGET  = "OurStory"
TEAM_ID = "955DP87LHM"
DEVICE = "iPhone 17 (26.0)"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Сборка проекта и запуск тестов"
  lane :tests do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [DEVICE],
      clean: true,
      parallel_testing: false,
      reset_simulator: true,
      output_types: "junit,html"
    )
  end

  desc "Тесты + выгрузка в TestFlight только для внутреннего тестирования"
  lane :tf_internal do
    tests
    upload(internal_only: true)
  end

  desc "Выгрузка в TestFlight с возможностью отправить в App Store"
  lane :release do
    upload(internal_only: false)
  end

  # Общая логика сборки и выгрузки
  private_lane :upload do |options|
    internal_only = options[:internal_only]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(type: "appstore", app_identifier: APP_ID, readonly: true, api_key: api_key)
    profile_name = ENV["sigh_#{APP_ID}_appstore_profile-name"]

    update_code_signing_settings(
      path: PROJECT,
      targets: [TARGET],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_number = latest_testflight_build_number(
      app_identifier: APP_ID,
      api_key: api_key,
      initial_build_number: 0
    ) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      output_directory: "build",
      export_options: {
        method: "app-store",
        provisioningProfiles: { APP_ID => profile_name },
        testFlightInternalTestingOnly: internal_only
      }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
