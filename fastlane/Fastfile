default_platform(:ios)

APP_ID  = "Nebo.OurStory"
PROJECT = "OurStory.xcodeproj"
SCHEME  = "OurStory"
TARGET  = "OurStory"
TEAM_ID = "955DP87LHM"
DEVICE = "iPhone 17 (26.0)"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Сборка проекта и запуск тестов"
  lane :tests do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [DEVICE],
      clean: true,
      parallel_testing: false,
      reset_simulator: true,
      output_types: "junit,html"
    )
  end

  desc "Сборка и загрузка в TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 1. Скачать сертификат и профиль
    match(type: "appstore", app_identifier: APP_ID, readonly: true, api_key: api_key)

    # 2. Переключить подпись Release на ручную (только на время сборки)
    update_code_signing_settings(
      path: PROJECT,
      targets: [TARGET],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_#{APP_ID}_appstore_profile-name"]
    )

    # 3. Номер сборки = последний в TestFlight + 1
    build_number = latest_testflight_build_number(
      app_identifier: APP_ID,
      api_key: api_key,
      initial_build_number: 0
    ) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)

    # 4. Сборка .ipa
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build"
    )

    # 5. Загрузка в TestFlight
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
